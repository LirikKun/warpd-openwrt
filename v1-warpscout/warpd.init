#!/bin/sh /etc/rc.common
# warpd — WARP/WARP-to-WARP proxy supervisor for OpenWrt.
# Provides two local SOCKS5 proxies (via warpscout socks, userspace only,
# no TUN, no routes, no firewall changes) and a small web UI.
# Logs and scan state live in RAM (/tmp, /var/run); ROM is touched only by
# apk package install and UCI config commits.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/warpd

start_service() {
    config_load warpd
    config_get_bool enabled global enabled 1
    [ "$enabled" = "1" ] || return 0

    mkdir -p /var/run/warpd /var/warpd /etc/warpd

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param env GOMEMLIMIT=24MiB GOGC=400
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0 0"
    procd_close_instance
}

reload_service() {
    stop
    sleep 1
    start
}

service_triggers() {
    procd_add_reload_trigger "warpd"
}
