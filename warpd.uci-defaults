# warpd UCI defaults — fresh seed only; dynamic profiles belong to the daemon.
set -eu
# Never replay defaults over any existing UCI (including legacy migration input)
# or an existing/explicitly empty dynamic store. Never follow config symlinks.
for directory in /etc /etc/config /etc/warpd; do
    [ ! -L "$directory" ] || exit 1
    [ ! -e "$directory" ] || [ -d "$directory" ] || exit 1
done
[ ! -L /etc/config/warpd ] || exit 1
[ ! -e /etc/config/warpd ] || [ -f /etc/config/warpd ] || exit 1
[ ! -f /etc/config/warpd ] || exit 0
[ ! -e /etc/warpd/profiles.json ] && [ ! -L /etc/warpd/profiles.json ] || exit 0

umask 077
touch /etc/config/warpd

uci -q get warpd.global >/dev/null || {
    uci set warpd.global=warpd
    uci set warpd.global.profile_schema='1'
    uci set warpd.global.enabled='1'
    uci set warpd.global.check_period='300'
    uci set warpd.global.scan_sample='2'
    uci set warpd.global.scan_jobs='6'
    uci set warpd.global.web_listen='0.0.0.0'
    uci set warpd.global.web_port='9095'
    uci set warpd.global.web_secret=''
    uci set warpd.global.web_language='en'
    uci set warpd.global.autoscan_on_start='1'
    uci set warpd.global.fail_restart='3'
    uci set warpd.global.fail_rescan='5'
    uci set warpd.global.dme_rescan_gap='600'
    uci set warpd.global.max_ping='0'
}

uci -q get warpd.warp >/dev/null || {
    uci set warpd.warp=warp
    uci set warpd.warp.enabled='1'
    uci set warpd.warp.listen='0.0.0.0'
    uci set warpd.warp.port='4001'
    uci set warpd.warp.endpoint=''
    uci set warpd.warp.protocol='awg'
}

uci commit warpd
exit 0
