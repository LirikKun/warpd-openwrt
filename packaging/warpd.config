# Trusted LAN only: management and SOCKS listeners bind all IPv4 interfaces.
# Set global.web_secret and/or restrict listening addresses before exposure.
# This is a fresh-install seed, not an upgrade migration or dynamic profile list.
config warpd 'global'
    option profile_schema '1'
    option enabled '1'
    option check_period '300'
    option scan_sample '2'
    option scan_jobs '6'
    option web_listen '0.0.0.0'
    option web_port '9095'
    option web_secret ''
    option web_language 'en'
    option autoscan_on_start '1'
    option fail_restart '3'
    option fail_rescan '5'
    option dme_rescan_gap '600'
    option max_ping '0'

config warp 'warp'
    option enabled '1'
    option listen '0.0.0.0'
    option port '4001'
    option endpoint ''
    option protocol 'awg'
